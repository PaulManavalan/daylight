NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Notion OAuth configuration. Never prefix these with NEXT_PUBLIC_.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Local server. On Vercel use https://daylightv50.vercel.app/api/notion/callback instead.
NOTION_REDIRECT_URI=http://127.0.0.1:3102/api/notion/callback
# Generate a random secret of at least 32 characters. Used for encrypted HttpOnly cookies.
NOTION_COOKIE_SECRET=

# Server-only Google Calendar OAuth. Start read-only; event editing requires additional consent.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact address in the Google Cloud web OAuth client.
# On Vercel, use the primary HTTPS deployment address instead.
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3104/api/google-calendar/callback
# Separate random secret of at least 32 characters for encrypted HttpOnly cookies.
GOOGLE_CALENDAR_COOKIE_SECRET=

# Server-only iCloud CalDAV connection. No Apple account password belongs in this file.
# The user enters an Apple app-specific password in Daylight's connection screen.
ICLOUD_CALENDAR_ORIGIN=http://127.0.0.1:3104
# Separate random secret of at least 32 characters, used for encrypted HttpOnly cookies.
ICLOUD_CALENDAR_COOKIE_SECRET=
