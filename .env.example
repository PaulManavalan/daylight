NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Notion OAuth configuration. Never prefix these with NEXT_PUBLIC_.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Local server. On Vercel use https://daylightv50.vercel.app/api/notion/callback instead.
NOTION_REDIRECT_URI=http://127.0.0.1:3102/api/notion/callback
# Generate a random secret of at least 32 characters. Used for encrypted HttpOnly cookies.
NOTION_COOKIE_SECRET=
